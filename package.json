{
  "name": "conjunction",
  "version": "0.0.0",
  "private": true,
  "description": "Orchestration runtime for coding agents: tasks, runs, isolated Git worktrees, deterministic verification.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.5",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "conjunction": "./dist/cli/main.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "eval:live": "node scripts/live-eval.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
